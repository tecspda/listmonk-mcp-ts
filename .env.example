# Listmonk MCP Server Configuration
# Copy this file to .env and adjust values

LISTMONK_MCP_URL=http://localhost:9000
LISTMONK_MCP_USERNAME=api_admin
LISTMONK_MCP_PASSWORD=generate-api-token-from-your-server-instance
LISTMONK_MCP_TIMEOUT=30
LISTMONK_MCP_MAX_RETRIES=3
# Directory the file tools (*_from_file, upload_media_file) may read from; unset = disabled
# LISTMONK_MCP_FILES_DIR=/path/to/email-templates
LISTMONK_MCP_SERVER_NAME="Listmonk MCP Server"
